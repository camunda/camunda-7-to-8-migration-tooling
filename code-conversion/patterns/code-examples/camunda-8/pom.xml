<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.3</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>io.camunda.conversion</groupId>
	<artifactId>camunda_8_code_examples</artifactId>
	<version>0.2.11-SNAPSHOT</version>
	<name>Camunda 8 Code Examples</name>
	<description>Collection of examples created for the Camunda 7 to Camunda 8 Code Conversion Pattern Collection</description>
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection></connection>
		<developerConnection></developerConnection>
		<tag></tag>
		<url></url>
	</scm>
	<properties>
		<java.version>17</java.version>
		<version.spring-boot>4.1.3</version.spring-boot>
		<version.jackson-bom>2.22.4</version.jackson-bom>
		<version.jackson-3-bom>3.2.4</version.jackson-3-bom>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.fasterxml.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${version.jackson-bom}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>tools.jackson</groupId>
				<artifactId>jackson-bom</artifactId>
				<version>${version.jackson-3-bom}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>io.camunda</groupId>
			<artifactId>camunda-spring-boot-starter</artifactId>
			<version>8.10.8</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>io.camunda</groupId>
			<artifactId>camunda-process-test-spring</artifactId>
			<version>8.10.8</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>reject-vulnerable-spring-dependencies</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>org.springframework:spring-web:(,5.3.51)</exclude>
										<exclude>org.springframework:spring-web:[6.0,6.0.33)</exclude>
										<exclude>org.springframework:spring-web:[6.1,6.1.30)</exclude>
										<exclude>org.springframework:spring-web:[6.2,6.2.21)</exclude>
										<exclude>org.springframework:spring-web:[7.0,7.0.11)</exclude>
										<exclude>org.springframework:spring-webmvc:(,5.3.50)</exclude>
										<exclude>org.springframework:spring-webmvc:[6.0,6.0.31)</exclude>
										<exclude>org.springframework:spring-webmvc:[6.1,6.1.29)</exclude>
										<exclude>org.springframework:spring-webmvc:[6.2,6.2.21)</exclude>
										<exclude>org.springframework:spring-webmvc:[7.0,7.0.11)</exclude>
										<exclude>org.springframework:spring-beans:(,5.3.51)</exclude>
										<exclude>org.springframework:spring-beans:[6.0,6.0.33)</exclude>
										<exclude>org.springframework:spring-beans:[6.1,6.1.30)</exclude>
										<exclude>org.springframework:spring-beans:[6.2,6.2.21)</exclude>
										<exclude>org.springframework:spring-beans:[7.0,7.0.11)</exclude>
										<exclude>org.springframework:spring-expression:(,5.3.51)</exclude>
										<exclude>org.springframework:spring-expression:[6.0,6.0.33)</exclude>
										<exclude>org.springframework:spring-expression:[6.1,6.1.30)</exclude>
										<exclude>org.springframework:spring-expression:[6.2,6.2.21)</exclude>
										<exclude>org.springframework:spring-expression:[7.0,7.0.11)</exclude>
										<exclude>org.springframework:spring-core:[6.1,6.1.30)</exclude>
										<exclude>org.springframework:spring-core:[6.2,6.2.21)</exclude>
										<exclude>org.springframework:spring-core:[7.0,7.0.11)</exclude>
										<exclude>org.springframework.boot:spring-boot-actuator:(,2.7.36)</exclude>
										<exclude>org.springframework.boot:spring-boot-actuator:[3.0,3.4.19)</exclude>
										<exclude>org.springframework.boot:spring-boot-actuator:[3.5,3.5.18)</exclude>
										<exclude>org.springframework.boot:spring-boot-actuator:[4.0,4.0.10)</exclude>
										<exclude>org.springframework.boot:spring-boot-actuator:[4.1,4.1.3)</exclude>
										<exclude>org.springframework.boot:spring-boot-webmvc:(,2.7.36)</exclude>
										<exclude>org.springframework.boot:spring-boot-webmvc:[3.0,3.4.19)</exclude>
										<exclude>org.springframework.boot:spring-boot-webmvc:[3.5,3.5.18)</exclude>
										<exclude>org.springframework.boot:spring-boot-webmvc:[4.0,4.0.10)</exclude>
										<exclude>org.springframework.boot:spring-boot-webmvc:[4.1,4.1.3)</exclude>
									</excludes>
									<message>
										Use patched Spring Framework and Spring Boot Actuator/WebMVC versions as required by the root dependency guard.
									</message>
									<searchTransitive>true</searchTransitive>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<version>${version.spring-boot}</version>
			</plugin>
			<plugin>
				<!-- Examples for the pattern collection, not a release artifact -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
