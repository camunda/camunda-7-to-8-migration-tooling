<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ProjectInstanceSearch" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="ProjectInstanceSearch" isExecutable="true">
    <bpmn:startEvent id="Start" name="Start process">
      <bpmn:outgoing>Flow_StartToWait</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_StartToWait" sourceRef="Start" targetRef="WaitForTest" />
    <bpmn:serviceTask id="WaitForTest" name="Wait for test">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wait-for-test" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_WaitToEnd" sourceRef="WaitForTest" targetRef="End" />
    <bpmn:endEvent id="End" name="Complete process">
      <bpmn:incoming>Flow_WaitToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ProjectInstanceSearch">
    <bpmndi:BPMNPlane id="BPMNPlane_ProjectInstanceSearch" bpmnElement="ProjectInstanceSearch">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForTest_di" bpmnElement="WaitForTest">
        <dc:Bounds x="240" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="392" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToWait_di" bpmnElement="Flow_StartToWait">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WaitToEnd_di" bpmnElement="Flow_WaitToEnd">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="392" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
