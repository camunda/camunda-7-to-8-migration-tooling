{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": [
    "main",
    "maintenance/0.2",
  ],
  "packageRules": [
    {
      "description": "Ignore SNAPSHOT versions for all packages.",
      "matchPackageNames": ["*"],
      "allowedVersions": "!/.*-SNAPSHOT$/",
      "enabled": true
    },
    {
      "description": "Pin internal modules to current version",
      "enabled": false,
      "matchPackageNames": [
        "io.camunda:camunda-7-to-8-data-migrator{/,}**",
        "io.camunda:camunda-7-to-8-migration-tooling-root{/,}**"
      ]
    },
    {
      "description": "Disable updates for code-conversion modules",
      "enabled": false,
      "matchPackageNames": [
        "io.camunda:camunda-7-to-8-code-conversion{/,}**"
      ]
    },
    {
      "description": "Pin internal diagram-converter modules to current version",
      "enabled": false,
      "matchPackageNames": [
        "io.camunda:camunda-7-to-8-diagram-converter{/,}**"
      ]
    },
    {
      "description": "Do not update npm packages in diagram-converter TODO: camunda/camunda-7-to-8-migration-tooling/issues/583",
      "matchManagers": ["npm"],
      "matchFileNames": ["diagram-converter/**"],
      "enabled": false
    },
    {
      "description": "Do not update C8 on main",
      "matchBaseBranches": ["main"],
      "matchPackageNames": ["io.camunda**"],
      "enabled": false
    },
    {
      "description": "On any maintenance branch, restrict C8 updates to patch updates only (no minor or major).",
      "matchBaseBranches": ["/^maintenance\\//"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false,
      "matchPackageNames": [
        "io.camunda**{/,}**"
      ]
    },
    {
      "description": "Automerge all updates with green CI.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true,
      "addLabels": [
        "automerge"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
