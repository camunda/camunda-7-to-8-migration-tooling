{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": [
    "main",
    "maintenance/0.2",
    "maintenance/0.3",
    "maintenance/8.10"
  ],
  "packageRules": [
    {
      "description": "Ignore SNAPSHOT versions for all packages.",
      "matchPackageNames": ["*"],
      "allowedVersions": "!/.*-SNAPSHOT$/",
      "enabled": true
    },
    {
      "description": "Disable updates for unavailable Camunda 7 starter artifacts",
      "enabled": false,
      "matchPackageNames": [
        "org.camunda.bpm.springboot:camunda-bpm-spring-boot-starter-4-external-task-client",
        "org.camunda.bpm.springboot:camunda-bpm-spring-boot-starter-4-test"
      ]
    },
    {
      "description": "Pin internal modules to current version",
      "enabled": false,
      "matchPackageNames": [
        "io.camunda:camunda-7-to-8-data-migrator{/,}**",
        "io.camunda:camunda-7-to-8-migration-tooling-root{/,}**"
      ]
    },
    {
      "description": "Disable updates for code-conversion modules",
      "enabled": false,
      "matchPackageNames": [
        "io.camunda:camunda-7-to-8-code-conversion-recipes{/,}**"
      ]
    },
    {
      "description": "Pin internal diagram-converter modules to current version",
      "enabled": false,
      "matchPackageNames": [
        "io.camunda:camunda-7-to-8-diagram-converter{/,}**"
      ]
    },
    {
      "description": "On any maintenance branch, restrict Camunda 8 packages to patch updates only (no minor or major).",
      "matchBaseBranches": ["/^maintenance\\//"],
      "matchUpdateTypes": ["minor", "major"],
      "enabled": false,
      "matchPackageNames": [
        "io.camunda**{/,}**"
      ]
    },
    {
      "description": "Automerge all updates with green CI.",
      "matchPackageNames": [
        "*"
      ],
      "automerge": true,
      "addLabels": [
        "automerge"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  }
}
