{
  "name": "camunda-7-to-8-data-migrator-cockpit-plugin",
  "version": "0.0.1",
  "scripts": {
    "build": "npm run typecheck && npm run check:type-escapes && cross-env NODE_ENV=production rollup -c",
    "build:dev": "cross-env NODE_ENV=development rollup -c",
    "build:watch": "cross-env NODE_ENV=development rollup -c -w",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:type-escapes": "node scripts/check-type-escapes.mjs",
    "copy": "cpx2 \"dist/**/*\" \"../target/classes/plugin-webapp/migrator-plugin/app/\"",
    "watch": "npm run build:watch & chokidar \"dist/**/*\" -c \"npm run copy\"",
    "livereload": "node livereload-server.js",
    "dev": "cross-env NODE_ENV=development rollup -c -w & npm run livereload",
    "dev:full": "cross-env NODE_ENV=development npm-run-all --parallel build:watch livereload"
  },
  "type": "module",
  "dependencies": {
    "@babel/runtime": "~8.0.0",
    "@tanstack/react-table": "^9.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  },
  "devDependencies": {
    "@babel/core": "~8.0.0",
    "@babel/plugin-transform-runtime": "~8.0.0",
    "@babel/preset-env": "~8.0.0",
    "@babel/preset-react": "~8.0.0",
    "@rollup/plugin-babel": "~7.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@rollup/plugin-commonjs": "~29.0.0",
    "@rollup/plugin-node-resolve": "~16.0.0",
    "@rollup/plugin-replace": "~6.0.1",
    "chokidar-cli": "^3.0.0",
    "cpx2": "^9.0.0",
    "cross-env": "^10.0.0",
    "livereload": "^0.10.0",
    "npm-run-all2": "^9.0.0",
    "rollup": "~4.63.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "~4.0.0",
    "sass": "^1.79.4",
    "typescript": "^7.0.0"
  }
}