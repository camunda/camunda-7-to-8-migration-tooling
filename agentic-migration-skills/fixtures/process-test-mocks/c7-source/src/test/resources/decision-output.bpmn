<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_DecisionOutput"
                  targetNamespace="http://camunda.org/examples/process-test-mocks">
  <bpmn:process id="decision-output" name="Decision output" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_DecisionOutput">
      <bpmn:outgoing>Flow_Start_Decision</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_Decision" sourceRef="Start_DecisionOutput" targetRef="Task_DecideInvoice" />
    <bpmn:businessRuleTask id="Task_DecideInvoice"
                           name="Decide invoice"
                           camunda:decisionRef="invoice_risk"
                           camunda:resultVariable="riskOutcome"
                           camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>Flow_Start_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_End</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_Decision_End" sourceRef="Task_DecideInvoice" targetRef="End_DecisionOutput" />
    <bpmn:endEvent id="End_DecisionOutput">
      <bpmn:incoming>Flow_Decision_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
