<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_RepeatedNotify"
                  targetNamespace="http://camunda.org/examples/process-test-mocks">
  <bpmn:process id="repeated-notify" name="Repeated notify" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_RepeatedNotify">
      <bpmn:outgoing>Flow_Start_First</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Start_First" sourceRef="Start_RepeatedNotify" targetRef="Task_Notify_First" />
    <bpmn:serviceTask id="Task_Notify_First" name="Notify first" camunda:delegateExpression="${notifyDelegate}">
      <bpmn:incoming>Flow_Start_First</bpmn:incoming>
      <bpmn:outgoing>Flow_First_Second</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_First_Second" sourceRef="Task_Notify_First" targetRef="Task_Notify_Second" />
    <bpmn:serviceTask id="Task_Notify_Second" name="Notify second" camunda:delegateExpression="${notifyDelegate}">
      <bpmn:incoming>Flow_First_Second</bpmn:incoming>
      <bpmn:outgoing>Flow_Second_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Second_End" sourceRef="Task_Notify_Second" targetRef="End_RepeatedNotify" />
    <bpmn:endEvent id="End_RepeatedNotify">
      <bpmn:incoming>Flow_Second_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
