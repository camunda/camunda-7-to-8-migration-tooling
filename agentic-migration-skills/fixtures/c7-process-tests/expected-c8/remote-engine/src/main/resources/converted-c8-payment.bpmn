<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_Payment"
                  targetNamespace="http://camunda.com/fixture/payment"
                  exporter="Camunda Modeler"
                  exporterVersion="5.32.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="payment" name="Payment" isExecutable="true">
    <bpmn:startEvent id="Start_Payment" name="Start payment">
      <bpmn:outgoing>Flow_Start_Charge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ChargePayment" name="Charge payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Charge</bpmn:incoming>
      <bpmn:outgoing>Flow_Charge_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Payment" name="Payment complete">
      <bpmn:incoming>Flow_Charge_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Charge" sourceRef="Start_Payment" targetRef="Task_ChargePayment" />
    <bpmn:sequenceFlow id="Flow_Charge_End" sourceRef="Task_ChargePayment" targetRef="End_Payment" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Payment">
    <bpmndi:BPMNPlane id="Plane_Payment" bpmnElement="payment">
      <bpmndi:BPMNShape id="Start_Payment_di" bpmnElement="Start_Payment">
        <dc:Bounds x="100" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChargePayment_di" bpmnElement="Task_ChargePayment">
        <dc:Bounds x="190" y="88" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Payment_di" bpmnElement="End_Payment">
        <dc:Bounds x="350" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Charge_di" bpmnElement="Flow_Start_Charge">
        <di:waypoint x="136" y="128" />
        <di:waypoint x="190" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Charge_End_di" bpmnElement="Flow_Charge_End">
        <di:waypoint x="290" y="128" />
        <di:waypoint x="350" y="128" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
