<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_Housekeeping"
                  targetNamespace="http://camunda.com/fixture/housekeeping"
                  exporter="Camunda Modeler"
                  exporterVersion="5.32.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="housekeeping" name="Housekeeping" isExecutable="true">
    <bpmn:startEvent id="Start_Housekeeping" name="Start housekeeping">
      <bpmn:outgoing>Flow_Start_Review</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Review" name="Review housekeeping">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="housekeeping-task" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Housekeeping" name="Housekeeping complete">
      <bpmn:incoming>Flow_Review_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="Start_Housekeeping" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="Task_Review" targetRef="End_Housekeeping" />
  </bpmn:process>
</bpmn:definitions>
