<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Fulfillment"
                  targetNamespace="http://camunda.com/fixture/fulfillment"
                  exporter="Camunda Modeler"
                  exporterVersion="5.32.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_CarrierConfirmed" name="CarrierConfirmed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=orderId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="fulfillment" name="Fulfillment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Fulfillment" name="Start">
      <bpmn:outgoing>Flow_Start_CompleteWork</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="CompleteWork" name="Complete work">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="fulfillment-task" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_CompleteWork</bpmn:incoming>
      <bpmn:outgoing>Flow_CompleteWork_BookCarrier</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="DailyReminder" name="Daily reminder" attachedToRef="CompleteWork" cancelActivity="false">
      <bpmn:outgoing>Flow_DailyReminder_RemindColleague</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="RemindColleague" name="Remind colleague">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="fulfillment-task" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DailyReminder_RemindColleague</bpmn:incoming>
      <bpmn:outgoing>Flow_RemindColleague_ColleagueReminded</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ColleagueReminded" name="Colleague reminded">
      <bpmn:incoming>Flow_RemindColleague_ColleagueReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BookCarrier" name="Book carrier">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="book-carrier" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CompleteWork_BookCarrier</bpmn:incoming>
      <bpmn:outgoing>Flow_BookCarrier_WaitForConfirmation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="WaitForCarrierConfirmation" name="Wait for carrier confirmation">
      <bpmn:incoming>Flow_BookCarrier_WaitForConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForConfirmation_ShipOrder</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CarrierConfirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="ShipOrder" name="Ship order">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="shipping" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WaitForConfirmation_ShipOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ShipOrder_WorkFinished</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="WorkFinished" name="Work finished">
      <bpmn:incoming>Flow_ShipOrder_WorkFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_CompleteWork" sourceRef="StartEvent_Fulfillment" targetRef="CompleteWork" />
    <bpmn:sequenceFlow id="Flow_CompleteWork_BookCarrier" sourceRef="CompleteWork" targetRef="BookCarrier" />
    <bpmn:sequenceFlow id="Flow_DailyReminder_RemindColleague" sourceRef="DailyReminder" targetRef="RemindColleague" />
    <bpmn:sequenceFlow id="Flow_RemindColleague_ColleagueReminded" sourceRef="RemindColleague" targetRef="ColleagueReminded" />
    <bpmn:sequenceFlow id="Flow_BookCarrier_WaitForConfirmation" sourceRef="BookCarrier" targetRef="WaitForCarrierConfirmation" />
    <bpmn:sequenceFlow id="Flow_WaitForConfirmation_ShipOrder" sourceRef="WaitForCarrierConfirmation" targetRef="ShipOrder" />
    <bpmn:sequenceFlow id="Flow_ShipOrder_WorkFinished" sourceRef="ShipOrder" targetRef="WorkFinished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Fulfillment">
    <bpmndi:BPMNPlane id="Plane_Fulfillment" bpmnElement="fulfillment">
      <bpmndi:BPMNShape id="StartEvent_Fulfillment_di" bpmnElement="StartEvent_Fulfillment">
        <dc:Bounds x="100" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompleteWork_di" bpmnElement="CompleteWork">
        <dc:Bounds x="180" y="88" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DailyReminder_di" bpmnElement="DailyReminder">
        <dc:Bounds x="212" y="150" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RemindColleague_di" bpmnElement="RemindColleague">
        <dc:Bounds x="180" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ColleagueReminded_di" bpmnElement="ColleagueReminded">
        <dc:Bounds x="320" y="292" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BookCarrier_di" bpmnElement="BookCarrier">
        <dc:Bounds x="340" y="88" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForCarrierConfirmation_di" bpmnElement="WaitForCarrierConfirmation">
        <dc:Bounds x="500" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShipOrder_di" bpmnElement="ShipOrder">
        <dc:Bounds x="590" y="88" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WorkFinished_di" bpmnElement="WorkFinished">
        <dc:Bounds x="750" y="110" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_CompleteWork_di" bpmnElement="Flow_Start_CompleteWork">
        <di:waypoint x="136" y="128" />
        <di:waypoint x="180" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CompleteWork_BookCarrier_di" bpmnElement="Flow_CompleteWork_BookCarrier">
        <di:waypoint x="280" y="128" />
        <di:waypoint x="340" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DailyReminder_RemindColleague_di" bpmnElement="Flow_DailyReminder_RemindColleague">
        <di:waypoint x="230" y="186" />
        <di:waypoint x="230" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RemindColleague_ColleagueReminded_di" bpmnElement="Flow_RemindColleague_ColleagueReminded">
        <di:waypoint x="280" y="310" />
        <di:waypoint x="320" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BookCarrier_WaitForConfirmation_di" bpmnElement="Flow_BookCarrier_WaitForConfirmation">
        <di:waypoint x="440" y="128" />
        <di:waypoint x="500" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_WaitForConfirmation_ShipOrder_di" bpmnElement="Flow_WaitForConfirmation_ShipOrder">
        <di:waypoint x="536" y="128" />
        <di:waypoint x="590" y="128" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShipOrder_WorkFinished_di" bpmnElement="Flow_ShipOrder_WorkFinished">
        <di:waypoint x="690" y="128" />
        <di:waypoint x="750" y="128" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
