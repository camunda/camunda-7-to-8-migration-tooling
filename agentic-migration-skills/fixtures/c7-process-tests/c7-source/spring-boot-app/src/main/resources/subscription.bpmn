<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  targetNamespace="http://camunda.com/fixture/subscription">
  <bpmn:process id="subscription" name="Activate subscription" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_Subscription" name="Start subscription">
      <bpmn:outgoing>Flow_Start_Activate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Activate" name="Activate subscription" camunda:delegateExpression="${activateSubscriptionDelegate}">
      <bpmn:incoming>Flow_Start_Activate</bpmn:incoming>
      <bpmn:outgoing>Flow_Activate_Welcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_WelcomeCall" name="Schedule welcome call">
      <bpmn:incoming>Flow_Activate_Welcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Welcome_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Subscription" name="Subscription ready">
      <bpmn:incoming>Flow_Welcome_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Activate" sourceRef="Start_Subscription" targetRef="Task_Activate" />
    <bpmn:sequenceFlow id="Flow_Activate_Welcome" sourceRef="Task_Activate" targetRef="Task_WelcomeCall" />
    <bpmn:sequenceFlow id="Flow_Welcome_End" sourceRef="Task_WelcomeCall" targetRef="End_Subscription" />
  </bpmn:process>
</bpmn:definitions>
