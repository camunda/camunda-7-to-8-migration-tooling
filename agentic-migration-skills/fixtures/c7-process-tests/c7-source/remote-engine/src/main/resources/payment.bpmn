<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  targetNamespace="http://camunda.com/fixture/payment">
  <bpmn:process id="payment" name="Payment" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_Payment" name="Start payment">
      <bpmn:outgoing>Flow_Start_Charge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ChargePayment" name="Charge payment" camunda:type="external" camunda:topic="charge-payment">
      <bpmn:incoming>Flow_Start_Charge</bpmn:incoming>
      <bpmn:outgoing>Flow_Charge_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Payment" name="Payment complete">
      <bpmn:incoming>Flow_Charge_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Charge" sourceRef="Start_Payment" targetRef="Task_ChargePayment" />
    <bpmn:sequenceFlow id="Flow_Charge_End" sourceRef="Task_ChargePayment" targetRef="End_Payment" />
  </bpmn:process>
</bpmn:definitions>
