<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_TimerRearm" targetNamespace="http://camunda.io/schema/1.0/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.21">
  <bpmn:message id="Message_TerminationDateChanged" name="TerminationDateChanged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=projectId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="active-timer-rescheduling" isExecutable="true">
    <bpmn:startEvent id="Start" name="Start timer">
      <bpmn:outgoing>Flow_Start_Rearm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="PrepareTimer" name="Prepare timer">
      <bpmn:incoming>Flow_Start_Rearm</bpmn:incoming>
      <bpmn:incoming>Flow_Update_Rearm</bpmn:incoming>
      <bpmn:outgoing>Flow_Rearm_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="WaitForDateOrUpdate" name="Wait for date or update" eventGatewayType="Exclusive">
      <bpmn:incoming>Flow_Rearm_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Wait_Timer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Wait_Update</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TerminationTimer" name="Termination date reached">
      <bpmn:incoming>Flow_Wait_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_Deadline</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDate>=date and time(terminationDate)</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="DateChanged" name="Termination date changed">
      <bpmn:incoming>Flow_Wait_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Update_Rearm</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_TerminationDateChanged" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="DeadlineReached" name="Termination deadline reached">
      <bpmn:incoming>Flow_Timer_Deadline</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Rearm" sourceRef="Start" targetRef="PrepareTimer" />
    <bpmn:sequenceFlow id="Flow_Rearm_Wait" sourceRef="PrepareTimer" targetRef="WaitForDateOrUpdate" />
    <bpmn:sequenceFlow id="Flow_Wait_Timer" sourceRef="WaitForDateOrUpdate" targetRef="TerminationTimer" />
    <bpmn:sequenceFlow id="Flow_Wait_Update" sourceRef="WaitForDateOrUpdate" targetRef="DateChanged" />
    <bpmn:sequenceFlow id="Flow_Update_Rearm" sourceRef="DateChanged" targetRef="PrepareTimer" />
    <bpmn:sequenceFlow id="Flow_Timer_Deadline" sourceRef="TerminationTimer" targetRef="DeadlineReached" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_TimerRearm">
    <bpmndi:BPMNPlane id="Plane_TimerRearm" bpmnElement="active-timer-rescheduling">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="150" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForDateOrUpdate_di" bpmnElement="WaitForDateOrUpdate">
        <dc:Bounds x="360" y="153" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TerminationTimer_di" bpmnElement="TerminationTimer">
        <dc:Bounds x="520" y="75" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DateChanged_di" bpmnElement="DateChanged">
        <dc:Bounds x="520" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DeadlineReached_di" bpmnElement="DeadlineReached">
        <dc:Bounds x="670" y="75" width="36" height="36" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareTimer_di" bpmnElement="PrepareTimer">
        <dc:Bounds x="245" y="153" width="50" height="50" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Rearm_di" bpmnElement="Flow_Start_Rearm">
        <di:waypoint x="186" y="178" />
        <di:waypoint x="245" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rearm_Wait_di" bpmnElement="Flow_Rearm_Wait">
        <di:waypoint x="295" y="178" />
        <di:waypoint x="360" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wait_Timer_di" bpmnElement="Flow_Wait_Timer">
        <di:waypoint x="385" y="153" />
        <di:waypoint x="385" y="93" />
        <di:waypoint x="520" y="93" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wait_Update_di" bpmnElement="Flow_Wait_Update">
        <di:waypoint x="385" y="203" />
        <di:waypoint x="385" y="258" />
        <di:waypoint x="520" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Update_Rearm_di" bpmnElement="Flow_Update_Rearm">
        <di:waypoint x="520" y="258" />
        <di:waypoint x="330" y="258" />
        <di:waypoint x="270" y="203" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_Deadline_di" bpmnElement="Flow_Timer_Deadline">
        <di:waypoint x="556" y="93" />
        <di:waypoint x="670" y="93" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
