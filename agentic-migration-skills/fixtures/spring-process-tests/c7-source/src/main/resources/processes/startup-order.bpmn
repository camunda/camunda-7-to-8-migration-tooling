<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_Startup_Order"
                  targetNamespace="http://camunda.org/examples">
  <bpmn:process id="startup-order" name="Startup order" isExecutable="true"
                camunda:historyTimeToLive="P1D">
    <bpmn:startEvent id="StartEvent_Startup" />
    <bpmn:sequenceFlow id="Flow_Startup_Wait" sourceRef="StartEvent_Startup" targetRef="Task_StartupWait" />
    <bpmn:userTask id="Task_StartupWait" name="Wait for startup review" />
    <bpmn:sequenceFlow id="Flow_Startup_End" sourceRef="Task_StartupWait" targetRef="EndEvent_Startup" />
    <bpmn:endEvent id="EndEvent_Startup" />
  </bpmn:process>
</bpmn:definitions>
