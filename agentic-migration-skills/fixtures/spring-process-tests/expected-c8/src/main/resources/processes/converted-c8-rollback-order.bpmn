<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Rollback_Order" targetNamespace="http://camunda.org/examples" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="rollback-order" name="Rollback order" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Rollback" name="Order received">
      <bpmn:outgoing>Flow_Reserve</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Reserve" sourceRef="StartEvent_Rollback" targetRef="Task_Reserve" />
    <bpmn:serviceTask id="Task_Reserve" name="Reserve inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve-inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Charge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Charge" sourceRef="Task_Reserve" targetRef="Task_ChargeRollback" />
    <bpmn:serviceTask id="Task_ChargeRollback" name="Charge payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="charge-payment-rollback" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Charge</bpmn:incoming>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Fail" sourceRef="Task_ChargeRollback" targetRef="Task_Fail" />
    <bpmn:serviceTask id="Task_Fail" name="Reject payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fail-after-payment" retries="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_RollbackEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RollbackEnd" sourceRef="Task_Fail" targetRef="EndEvent_Rollback" />
    <bpmn:endEvent id="EndEvent_Rollback" name="Order rejected">
      <bpmn:incoming>Flow_RollbackEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Rollback_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Rollback_Order" bpmnElement="rollback-order">
      <bpmndi:BPMNShape id="StartEvent_Rollback_di" bpmnElement="StartEvent_Rollback">
        <dc:Bounds x="80" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reserve_di" bpmnElement="Task_Reserve">
        <dc:Bounds x="180" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ChargeRollback_di" bpmnElement="Task_ChargeRollback">
        <dc:Bounds x="330" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fail_di" bpmnElement="Task_Fail">
        <dc:Bounds x="480" y="118" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rollback_di" bpmnElement="EndEvent_Rollback">
        <dc:Bounds x="640" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Reserve_di" bpmnElement="Flow_Reserve">
        <di:waypoint x="116" y="158" />
        <di:waypoint x="180" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Charge_di" bpmnElement="Flow_Charge">
        <di:waypoint x="280" y="158" />
        <di:waypoint x="330" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fail_di" bpmnElement="Flow_Fail">
        <di:waypoint x="430" y="158" />
        <di:waypoint x="480" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RollbackEnd_di" bpmnElement="Flow_RollbackEnd">
        <di:waypoint x="580" y="158" />
        <di:waypoint x="640" y="158" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
