<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  targetNamespace="https://camunda.com/migration-fixtures">
  <bpmn:process id="formBearingProcess" isExecutable="true">
    <bpmn:startEvent id="StartFormBearing" />
    <bpmn:userTask id="FormBearingReview" camunda:formKey="fixture-review-form" />
    <bpmn:endEvent id="FormBearingComplete" />
    <bpmn:sequenceFlow id="Flow_Form_Start_Review" sourceRef="StartFormBearing" targetRef="FormBearingReview" />
    <bpmn:sequenceFlow id="Flow_Form_Review_End" sourceRef="FormBearingReview" targetRef="FormBearingComplete" />
  </bpmn:process>
</bpmn:definitions>
