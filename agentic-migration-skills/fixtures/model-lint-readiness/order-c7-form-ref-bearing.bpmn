<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  targetNamespace="https://camunda.com/migration-fixtures">
  <bpmn:process id="formRefBearingProcess" isExecutable="true">
    <bpmn:startEvent id="StartFormRefBearing" />
    <bpmn:userTask id="FormRefBearingReview" camunda:formRef="fixture-review-form" />
    <bpmn:endEvent id="FormRefBearingComplete" />
    <bpmn:sequenceFlow id="Flow_FormRef_Start_Review" sourceRef="StartFormRefBearing" targetRef="FormRefBearingReview" />
    <bpmn:sequenceFlow id="Flow_FormRef_Review_End" sourceRef="FormRefBearingReview" targetRef="FormRefBearingComplete" />
  </bpmn:process>
</bpmn:definitions>
