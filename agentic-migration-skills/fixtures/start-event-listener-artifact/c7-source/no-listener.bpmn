<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_NoListener"
                  targetNamespace="http://camunda.org/examples">
  <bpmn:process id="Process_NoListener" name="No listener" isExecutable="true">
    <bpmn:startEvent id="Start_NoListener" name="Start">
      <bpmn:outgoing>Flow_NoListenerToEnd</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_NoListener" name="End">
      <bpmn:incoming>Flow_NoListenerToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow
        id="Flow_NoListenerToEnd"
        sourceRef="Start_NoListener"
        targetRef="End_NoListener" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_NoListener">
    <bpmndi:BPMNPlane id="BPMNPlane_NoListener" bpmnElement="Process_NoListener">
      <bpmndi:BPMNShape id="Start_NoListener_di" bpmnElement="Start_NoListener">
        <dc:Bounds x="160" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_NoListenerToEnd_di" bpmnElement="Flow_NoListenerToEnd">
        <di:waypoint x="196" y="118" />
        <di:waypoint x="300" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="End_NoListener_di" bpmnElement="End_NoListener">
        <dc:Bounds x="300" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
