<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_KycForms" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_LegacyKycIntake" name="legacy-kyc-intake" />
  <bpmn:process id="kycOnboarding" name="KYC customer onboarding" isExecutable="true">
    <bpmn:startEvent id="Start_KycApplication" name="Application received">
      <bpmn:extensionElements>
        <camunda:formData businessKey="applicationId">
          <camunda:formField id="applicationId" label="Application ID" type="string" defaultValue="KYC-2026-0001">
            <camunda:properties>
              <camunda:property id="sourceSystem" value="online-channel" />
              <camunda:property id="displayOrder" value="1" />
            </camunda:properties>
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="applicantName" label="Applicant name" type="string" defaultValue="Ada Lovelace">
            <camunda:validation>
              <camunda:constraint name="minlength" config="2" />
              <camunda:constraint name="maxlength" config="120" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="annualIncome" label="Annual income" type="long" defaultValue="85000">
            <camunda:validation>
              <camunda:constraint name="min" config="0" />
              <camunda:constraint name="max" config="1000000" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="legacyCreditLimit" label="Legacy credit limit" type="long" defaultValue="9007199254740992" />
          <camunda:formField id="consentGiven" label="Consent given" type="boolean" defaultValue="true">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="dateOfBirth" label="Date of birth" type="date" datePattern="dd/MM/yyyy" defaultValue="01/12/1985">
            <camunda:validation>
              <camunda:constraint name="readonly" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="riskTier" label="Risk tier" type="enum" defaultValue="standard">
            <camunda:value id="standard" name="Standard" />
            <camunda:value id="enhanced" name="Enhanced due diligence" />
            <camunda:value id="high" name="High risk" />
          </camunda:formField>
          <camunda:formField id="nationalId" label="National identifier" type="string">
            <camunda:validation>
              <camunda:constraint name="validator" config="com.example.NationalIdValidator" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="invalidConstraint" label="Constraint requiring review" type="string">
            <camunda:validation>
              <camunda:constraint name="validator" config="${constraintConfig}" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ApplicationToCapture</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CaptureApplicant" name="Capture applicant details">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="legalName" label="Legal name" type="string" />
          <camunda:formField id="countryOfResidence" label="Country of residence" type="string" />
          <camunda:formField id="consentConfirmed" label="Confirm consent" type="boolean" defaultValue="false" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplicationToCapture</bpmn:incoming>
      <bpmn:outgoing>Flow_CaptureToScreening</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RunSanctionsScreening" name="Run sanctions screening" camunda:type="external" camunda:topic="kyc-sanctions-screening">
      <bpmn:incoming>Flow_CaptureToScreening</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreeningToOutcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ScreeningOutcome" name="Screening outcome?" default="Flow_NeedsDocuments">
      <bpmn:incoming>Flow_ScreeningToOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreeningClear</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedsDocuments</bpmn:outgoing>
      <bpmn:outgoing>Flow_ScreeningReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestDocuments" name="Request missing documents">
      <bpmn:extensionElements>
        <camunda:formData businessKey="missingBusinessKeyField">
          <camunda:formField id="documentComment" label="${commentLabel}" type="string" defaultValue="${defaultComment}">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="applicant.address" label="Applicant address" type="string" />
          <camunda:formField id="document-number" label="Document number" type="string" />
          <camunda:formField id="missingLabel" type="string" />
          <camunda:formField id="missingType" label="Missing type" />
          <camunda:formField id="beneficialOwner" label="Beneficial owner" type="custom-party">
            <camunda:properties>
              <camunda:property id="partyRole" value="beneficial-owner" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="documentTemplate" label="{{ applicant.displayName }}" type="string" />
          <camunda:formField id="screeningReason" label="${execution.getVariable('screeningReason')}" type="string" />
          <camunda:formField id="documentType" label="Document type" type="enum">
            <camunda:value id="passport" name="Passport" />
            <camunda:value id="passport" name="Second passport option" />
            <camunda:value name="Missing option id" />
          </camunda:formField>
        </camunda:formData>
        <camunda:formData>
          <camunda:formField id="documentComment" label="Duplicate document comment" type="string" />
        </camunda:formData>
        <camunda:formProperty id="legacyDocumentReference" name="Legacy document reference" type="string" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsToRecheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RecheckScreening" name="Recheck screening result" camunda:type="external" camunda:topic="kyc-sanctions-screening">
      <bpmn:incoming>Flow_DocumentsToRecheck</bpmn:incoming>
      <bpmn:outgoing>Flow_RecheckToApprovalMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ApprovalMerge" name="Merge approval paths">
      <bpmn:incoming>Flow_ScreeningClear</bpmn:incoming>
      <bpmn:incoming>Flow_RecheckToApprovalMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalMergeToApprove</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ApproveCustomer" name="Approve customer">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approvalDecision" label="Approval decision" type="boolean" defaultValue="false">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="approvalNotes" label="Approval notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApprovalMergeToApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_CustomerApproved" name="Customer approved">
      <bpmn:incoming>Flow_ApprovalToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ManualReviewExistingForm" name="Review rejected application" camunda:formRef="existing-kyc-review-form" camunda:formRefBinding="deployment">
      <bpmn:incoming>Flow_ScreeningReject</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ApplicationRejected" name="Application rejected">
      <bpmn:incoming>Flow_RejectToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_LegacyKycIntake" name="Legacy KYC intake">
      <bpmn:extensionElements>
        <camunda:formProperty id="caseReference" name="Case reference" type="string" />
        <camunda:formProperty id="caseAlias" name="Case alias" type="string" variable="legacyCaseReference" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_LegacyIntakeToReview</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_LegacyKycIntake" messageRef="Message_LegacyKycIntake" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LegacyKycReview" name="Review legacy KYC properties">
      <bpmn:extensionElements>
        <camunda:formProperty id="legacyRequired" name="Required legacy text" type="string" required="true" />
        <camunda:formProperty id="legacyRequiredBoolean" name="Required legacy boolean" type="boolean" required="true" />
        <camunda:formProperty id="legacyUnreadable" name="Unreadable" type="string" readable="false" />
        <camunda:formProperty id="legacyNotWritable" name="Not writable" type="string" writable="false" />
        <camunda:formProperty id="legacyWriteableSpelling" name="Modeler-compatible writable flag" type="string" writable="false" />
        <camunda:formProperty id="legacyExpression" name="Expression alias" type="string" expression="${legacyValue}" />
        <camunda:formProperty id="legacyStaticDefault" name="Static risk score" type="long" default="7" />
        <camunda:formProperty id="legacyDynamicDefault" name="Dynamic default" type="string" default="${legacyDefault}" />
        <camunda:formProperty id="legacyDate" name="Legacy review date" type="date" datePattern="MM-dd-yyyy" default="12-31-2026" />
        <camunda:formProperty id="legacyEnum" name="Legacy document type" type="enum" default="passport">
          <camunda:value id="passport" name="Passport" />
          <camunda:value id="national-id" name="National ID" />
          <camunda:value id="residence-permit" name="Residence permit" />
        </camunda:formProperty>
        <camunda:formProperty id="legacyCustom" name="Legacy custom evidence" type="com.example.CustomEvidence" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LegacyIntakeToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_LegacyReviewToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_LegacyKycReview" name="Legacy review recorded">
      <bpmn:incoming>Flow_LegacyReviewToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ApplicationToCapture" sourceRef="Start_KycApplication" targetRef="Task_CaptureApplicant" />
    <bpmn:sequenceFlow id="Flow_CaptureToScreening" sourceRef="Task_CaptureApplicant" targetRef="Task_RunSanctionsScreening" />
    <bpmn:sequenceFlow id="Flow_ScreeningToOutcome" sourceRef="Task_RunSanctionsScreening" targetRef="Gateway_ScreeningOutcome" />
    <bpmn:sequenceFlow id="Flow_ScreeningClear" name="Clear" sourceRef="Gateway_ScreeningOutcome" targetRef="Gateway_ApprovalMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${screeningStatus == 'CLEAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NeedsDocuments" name="More documents needed" sourceRef="Gateway_ScreeningOutcome" targetRef="Task_RequestDocuments" />
    <bpmn:sequenceFlow id="Flow_ScreeningReject" name="Reject" sourceRef="Gateway_ScreeningOutcome" targetRef="Task_ManualReviewExistingForm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${screeningStatus == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DocumentsToRecheck" sourceRef="Task_RequestDocuments" targetRef="Task_RecheckScreening" />
    <bpmn:sequenceFlow id="Flow_RecheckToApprovalMerge" sourceRef="Task_RecheckScreening" targetRef="Gateway_ApprovalMerge" />
    <bpmn:sequenceFlow id="Flow_ApprovalMergeToApprove" sourceRef="Gateway_ApprovalMerge" targetRef="Task_ApproveCustomer" />
    <bpmn:sequenceFlow id="Flow_ApprovalToEnd" sourceRef="Task_ApproveCustomer" targetRef="End_CustomerApproved" />
    <bpmn:sequenceFlow id="Flow_RejectToEnd" sourceRef="Task_ManualReviewExistingForm" targetRef="End_ApplicationRejected" />
    <bpmn:sequenceFlow id="Flow_LegacyIntakeToReview" sourceRef="Start_LegacyKycIntake" targetRef="Task_LegacyKycReview" />
    <bpmn:sequenceFlow id="Flow_LegacyReviewToEnd" sourceRef="Task_LegacyKycReview" targetRef="End_LegacyKycReview" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_KycForms">
    <bpmndi:BPMNPlane id="BPMNPlane_KycForms" bpmnElement="kycOnboarding">
      <bpmndi:BPMNShape id="Start_KycApplication_di" bpmnElement="Start_KycApplication">
        <dc:Bounds x="80" y="270" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="55" y="313" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CaptureApplicant_di" bpmnElement="Task_CaptureApplicant">
        <dc:Bounds x="180" y="248" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RunSanctionsScreening_di" bpmnElement="Task_RunSanctionsScreening">
        <dc:Bounds x="340" y="248" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ScreeningOutcome_di" bpmnElement="Gateway_ScreeningOutcome" isMarkerVisible="true">
        <dc:Bounds x="500" y="263" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="320" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestDocuments_di" bpmnElement="Task_RequestDocuments">
        <dc:Bounds x="680" y="248" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecheckScreening_di" bpmnElement="Task_RecheckScreening">
        <dc:Bounds x="850" y="248" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ApprovalMerge_di" bpmnElement="Gateway_ApprovalMerge" isMarkerVisible="true">
        <dc:Bounds x="1000" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="982" y="172" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveCustomer_di" bpmnElement="Task_ApproveCustomer">
        <dc:Bounds x="1110" y="100" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_CustomerApproved_di" bpmnElement="End_CustomerApproved">
        <dc:Bounds x="1280" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1254" y="165" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualReviewExistingForm_di" bpmnElement="Task_ManualReviewExistingForm">
        <dc:Bounds x="680" y="470" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ApplicationRejected_di" bpmnElement="End_ApplicationRejected">
        <dc:Bounds x="850" y="492" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="822" y="535" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_LegacyKycIntake_di" bpmnElement="Start_LegacyKycIntake">
        <dc:Bounds x="80" y="700" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="55" y="743" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LegacyKycReview_di" bpmnElement="Task_LegacyKycReview">
        <dc:Bounds x="180" y="678" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_LegacyKycReview_di" bpmnElement="End_LegacyKycReview">
        <dc:Bounds x="360" y="700" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="332" y="743" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ApplicationToCapture_di" bpmnElement="Flow_ApplicationToCapture">
        <di:waypoint x="116" y="288" />
        <di:waypoint x="180" y="288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CaptureToScreening_di" bpmnElement="Flow_CaptureToScreening">
        <di:waypoint x="280" y="288" />
        <di:waypoint x="340" y="288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ScreeningToOutcome_di" bpmnElement="Flow_ScreeningToOutcome">
        <di:waypoint x="440" y="288" />
        <di:waypoint x="500" y="288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ScreeningClear_di" bpmnElement="Flow_ScreeningClear">
        <di:waypoint x="550" y="288" />
        <di:waypoint x="620" y="288" />
        <di:waypoint x="620" y="140" />
        <di:waypoint x="1000" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NeedsDocuments_di" bpmnElement="Flow_NeedsDocuments">
        <di:waypoint x="550" y="288" />
        <di:waypoint x="680" y="288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ScreeningReject_di" bpmnElement="Flow_ScreeningReject">
        <di:waypoint x="525" y="313" />
        <di:waypoint x="600" y="313" />
        <di:waypoint x="600" y="510" />
        <di:waypoint x="680" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DocumentsToRecheck_di" bpmnElement="Flow_DocumentsToRecheck">
        <di:waypoint x="780" y="288" />
        <di:waypoint x="850" y="288" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RecheckToApprovalMerge_di" bpmnElement="Flow_RecheckToApprovalMerge">
        <di:waypoint x="950" y="288" />
        <di:waypoint x="1025" y="288" />
        <di:waypoint x="1025" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalMergeToApprove_di" bpmnElement="Flow_ApprovalMergeToApprove">
        <di:waypoint x="1050" y="140" />
        <di:waypoint x="1110" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalToEnd_di" bpmnElement="Flow_ApprovalToEnd">
        <di:waypoint x="1210" y="140" />
        <di:waypoint x="1280" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectToEnd_di" bpmnElement="Flow_RejectToEnd">
        <di:waypoint x="780" y="510" />
        <di:waypoint x="850" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LegacyIntakeToReview_di" bpmnElement="Flow_LegacyIntakeToReview">
        <di:waypoint x="116" y="718" />
        <di:waypoint x="180" y="718" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LegacyReviewToEnd_di" bpmnElement="Flow_LegacyReviewToEnd">
        <di:waypoint x="280" y="718" />
        <di:waypoint x="360" y="718" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
