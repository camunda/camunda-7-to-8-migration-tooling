<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_MessageStart"
                  targetNamespace="http://camunda.org/examples">
  <bpmn:process id="messageStart" name="Message start" isExecutable="true">
    <bpmn:startEvent id="Start_Message">
      <bpmn:messageEventDefinition messageRef="Message_Start" />
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Message" />
    <bpmn:sequenceFlow id="Flow_StartToEnd" sourceRef="Start_Message" targetRef="End_Message" />
  </bpmn:process>
  <bpmn:message id="Message_Start" name="message-start" />
</bpmn:definitions>
