<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Implicit" targetNamespace="http://camunda.org/examples" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="implicit-process" isExecutable="true">
    <bpmn:startEvent id="Start_Implicit" name="Start implicit process">
      <bpmn:outgoing>Flow_Implicit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Implicit" name="Complete implicit process">
      <bpmn:incoming>Flow_Implicit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Implicit" sourceRef="Start_Implicit" targetRef="End_Implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Implicit">
    <bpmndi:BPMNPlane id="BPMNPlane_Implicit" bpmnElement="implicit-process">
      <bpmndi:BPMNShape id="Start_Implicit_di" bpmnElement="Start_Implicit">
        <dc:Bounds x="160" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Implicit_di" bpmnElement="End_Implicit">
        <dc:Bounds x="360" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Implicit_di" bpmnElement="Flow_Implicit">
        <di:waypoint x="196" y="140" />
        <di:waypoint x="360" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
