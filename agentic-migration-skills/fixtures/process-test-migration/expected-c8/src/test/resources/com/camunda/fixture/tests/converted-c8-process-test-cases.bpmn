<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:conversion="http://camunda.org/schema/conversion/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" conversion:converterVersion="0.3.6-SNAPSHOT" expressionLanguage="http://www.w3.org/1999/XPath" id="Definitions_ProcessTests" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0" targetNamespace="http://camunda.org/examples" typeLanguage="http://www.w3.org/2001/XMLSchema">
  <bpmn:message id="Message_Continue" name="ContinueMessage">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= orderId"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="order-process" isClosed="false" isExecutable="true" processType="None">
    <bpmn:startEvent id="Start_Order" isInterrupting="true" name="Start order" parallelMultiple="false">
      <bpmn:outgoing>Flow_Order_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask completionQuantity="1" id="Task_Approve" implementation="##unspecified" isForCompensation="false" name="Approve order" startQuantity="1">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="demo" candidateGroups="" candidateUsers=""/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Order_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_Approved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent attachedToRef="Task_Approve" cancelActivity="true" id="Boundary_Timer" name="Timer expires" parallelMultiple="false">
      <bpmn:outgoing>Flow_Order_Timer</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask completionQuantity="1" id="Task_Escalate" implementation="##unspecified" isForCompensation="false" name="Escalate order" startQuantity="1">
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Order_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Order_Timeout</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Approved" name="Order approved">
      <bpmn:incoming>Flow_Order_Approved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Timeout" name="Order timed out">
      <bpmn:incoming>Flow_Order_Timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Order_Start" sourceRef="Start_Order" targetRef="Task_Approve"/>
    <bpmn:sequenceFlow id="Flow_Order_Approved" sourceRef="Task_Approve" targetRef="End_Approved"/>
    <bpmn:sequenceFlow id="Flow_Order_Timer" sourceRef="Boundary_Timer" targetRef="Task_Escalate"/>
    <bpmn:sequenceFlow id="Flow_Order_Timeout" sourceRef="Task_Escalate" targetRef="End_Timeout"/>
  </bpmn:process>
  <bpmn:process id="async-process" isClosed="false" isExecutable="true" processType="None">
    <bpmn:startEvent id="Start_Async" isInterrupting="true" name="Start async process" parallelMultiple="false">
      <bpmn:outgoing>Flow_Async_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask completionQuantity="1" id="Task_Async" implementation="##WebService" isForCompensation="false" name="Run continuation" startQuantity="1">
      <bpmn:extensionElements>
        <conversion:message severity="REVIEW">Delegate class or expression 'com.camunda.fixture.tests.NoopDelegate' has been transformed to job type 'noopDelegate'.</conversion:message>
        <conversion:message severity="INFO">Unused attribute 'asyncBefore' on 'serviceTask' is removed.</conversion:message>
        <zeebe:taskHeaders>
          <zeebe:header key="class" value="com.camunda.fixture.tests.NoopDelegate"/>
        </zeebe:taskHeaders>
        <zeebe:taskDefinition type="noopDelegate"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Async_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Async_Continue</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask completionQuantity="1" id="Task_AfterAsync" implementation="##unspecified" isForCompensation="false" name="Continue after async" startQuantity="1">
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Async_Continue</bpmn:incoming>
      <bpmn:outgoing>Flow_Async_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Async" name="Async process complete">
      <bpmn:incoming>Flow_Async_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Async_Start" sourceRef="Start_Async" targetRef="Task_Async"/>
    <bpmn:sequenceFlow id="Flow_Async_Continue" sourceRef="Task_Async" targetRef="Task_AfterAsync"/>
    <bpmn:sequenceFlow id="Flow_Async_End" sourceRef="Task_AfterAsync" targetRef="End_Async"/>
  </bpmn:process>
  <bpmn:process id="message-process" isClosed="false" isExecutable="true" processType="None">
    <bpmn:startEvent id="Start_Message" isInterrupting="true" name="Start message process" parallelMultiple="false">
      <bpmn:outgoing>Flow_Message_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Message_Catch" name="Wait for continuation" parallelMultiple="false">
      <bpmn:extensionElements>
        <conversion:reference>Message_Continue</conversion:reference>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Message_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Message_End</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Continue"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Message" name="Message process complete">
      <bpmn:incoming>Flow_Message_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Message_Start" sourceRef="Start_Message" targetRef="Message_Catch"/>
    <bpmn:sequenceFlow id="Flow_Message_End" sourceRef="Message_Catch" targetRef="End_Message"/>
  </bpmn:process>
  <bpmn:process id="failing-process" isClosed="false" isExecutable="true" processType="None">
    <bpmn:startEvent id="Start_Failure" isInterrupting="true" name="Start failing process" parallelMultiple="false">
      <bpmn:outgoing>Flow_Failure_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask completionQuantity="1" id="Task_Fail" implementation="##WebService" isForCompensation="false" name="Fail process" startQuantity="1">
      <bpmn:extensionElements>
        <conversion:message severity="REVIEW">Delegate class or expression 'com.camunda.fixture.tests.FailingDelegate' has been transformed to job type 'failingDelegate'.</conversion:message>
        <zeebe:taskHeaders>
          <zeebe:header key="class" value="com.camunda.fixture.tests.FailingDelegate"/>
        </zeebe:taskHeaders>
        <zeebe:taskDefinition type="failingDelegate"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Failure_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Failure_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Failure" name="Failure process complete">
      <bpmn:incoming>Flow_Failure_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Failure_Start" sourceRef="Start_Failure" targetRef="Task_Fail"/>
    <bpmn:sequenceFlow id="Flow_Failure_End" sourceRef="Task_Fail" targetRef="End_Failure"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="order-process" id="BPMNPlane_1">
      <bpmndi:BPMNShape bpmnElement="Start_Order" id="Start_Order_di">
        <dc:Bounds height="36" width="36" x="160" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Approve" id="Task_Approve_di">
        <dc:Bounds height="80" width="100" x="256" y="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_Approved" id="End_Approved_di">
        <dc:Bounds height="36" width="36" x="416" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Boundary_Timer" id="Boundary_Timer_di">
        <dc:Bounds height="36" width="36" x="288" y="142"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Escalate" id="Task_Escalate_di">
        <dc:Bounds height="80" width="100" x="416" y="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_Timeout" id="End_Timeout_di">
        <dc:Bounds height="36" width="36" x="576" y="242"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_Order_Start" id="Flow_Order_Start_di">
        <di:waypoint x="196" y="120"/>
        <di:waypoint x="256" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Order_Approved" id="Flow_Order_Approved_di">
        <di:waypoint x="356" y="120"/>
        <di:waypoint x="416" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Order_Timer" id="Flow_Order_Timer_di">
        <di:waypoint x="306" y="178"/>
        <di:waypoint x="306" y="260"/>
        <di:waypoint x="416" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Order_Timeout" id="Flow_Order_Timeout_di">
        <di:waypoint x="516" y="260"/>
        <di:waypoint x="576" y="260"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane bpmnElement="async-process" id="BPMNPlane_2">
      <bpmndi:BPMNShape bpmnElement="Start_Async" id="Start_Async_di">
        <dc:Bounds height="36" width="36" x="160" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Async" id="Task_Async_di">
        <dc:Bounds height="80" width="100" x="256" y="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_AfterAsync" id="Task_AfterAsync_di">
        <dc:Bounds height="80" width="100" x="416" y="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_Async" id="End_Async_di">
        <dc:Bounds height="36" width="36" x="576" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_Async_Start" id="Flow_Async_Start_di">
        <di:waypoint x="196" y="120"/>
        <di:waypoint x="256" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Async_Continue" id="Flow_Async_Continue_di">
        <di:waypoint x="356" y="120"/>
        <di:waypoint x="416" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Async_End" id="Flow_Async_End_di">
        <di:waypoint x="516" y="120"/>
        <di:waypoint x="576" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_3">
    <bpmndi:BPMNPlane bpmnElement="message-process" id="BPMNPlane_3">
      <bpmndi:BPMNShape bpmnElement="Start_Message" id="Start_Message_di">
        <dc:Bounds height="36" width="36" x="160" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Message_Catch" id="Message_Catch_di">
        <dc:Bounds height="36" width="36" x="256" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_Message" id="End_Message_di">
        <dc:Bounds height="36" width="36" x="352" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_Message_Start" id="Flow_Message_Start_di">
        <di:waypoint x="196" y="120"/>
        <di:waypoint x="256" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Message_End" id="Flow_Message_End_di">
        <di:waypoint x="292" y="120"/>
        <di:waypoint x="352" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_4">
    <bpmndi:BPMNPlane bpmnElement="failing-process" id="BPMNPlane_4">
      <bpmndi:BPMNShape bpmnElement="Start_Failure" id="Start_Failure_di">
        <dc:Bounds height="36" width="36" x="160" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Fail" id="Task_Fail_di">
        <dc:Bounds height="80" width="100" x="256" y="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="End_Failure" id="End_Failure_di">
        <dc:Bounds height="36" width="36" x="416" y="102"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_Failure_Start" id="Flow_Failure_Start_di">
        <di:waypoint x="196" y="120"/>
        <di:waypoint x="256" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_Failure_End" id="Flow_Failure_End_di">
        <di:waypoint x="356" y="120"/>
        <di:waypoint x="416" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
