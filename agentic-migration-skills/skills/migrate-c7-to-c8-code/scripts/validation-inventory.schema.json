{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Camunda migration Step 2 inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules", "models"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "modules": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "models": {
          "minItems": 1
        }
      }
    }
  ]
}
