{
  "name": "diagram-converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && npm run check:type-escapes && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:type-escapes": "node scripts/check-type-escapes.mjs",
    "package": "npm run build && node copyfiles.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "bpmn-js": "^18.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@camunda/design-system": "^0.45.0",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "typescript": "^5.9.2",
    "vite": "^6.2.0"
  }
}
