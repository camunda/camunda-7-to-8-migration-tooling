{
  "name": "diagram-converter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && npm run check:type-escapes && npm run test && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:type-escapes": "node scripts/check-type-escapes.mjs",
    "package": "npm run build && node copyfiles.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bpmn-io/form-js-viewer": "^1.25.0",
    "@carbon/react": "^1.79.0",
    "bpmn-js": "^18.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "@testing-library/react": "^16.3.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
